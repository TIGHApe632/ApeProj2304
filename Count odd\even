#include <stdio.h>

// Function to count even numbers in the array
int countEven(int arr[], int n) {
    int evenCount = 0;
    for (int i = 0; i < n; i++) {
        if (arr[i] % 2 == 0) {
            evenCount++;
        }
    }
    return evenCount;
}

// Function to count odd numbers in the array
int countOdd(int arr[], int n) {
    int oddCount = 0;
    for (int i = 0; i < n; i++) {
        if (arr[i] % 2 != 0) {
            oddCount++;
        }
    }
    return oddCount;
}

int main() {
    int n;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    int arr[n];

    printf("Enter %d elements:\n", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    int evenNumbers = countEven(arr, n);
    int oddNumbers = countOdd(arr, n);

    printf("Number of even numbers = %d\n", evenNumbers);
    printf("Number of odd numbers = %d\n", oddNumbers);

    return 0;
}
