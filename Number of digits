#include <stdio.h>

int main() {
    int num, count = 0;

    printf("Enter a number: ");
    scanf("%d", &num);

    // Handle the case when number is 0
    if (num == 0) {
        count = 1;
    } else {
        // Make the number positive if it's negative
        if (num < 0) {
            num = -num;
        }

        while (num != 0) {
            num = num / 10;
            count++;
        }
    }

    printf("Number of digits: %d\n", count);

    return 0;
}
